# GENERIC kernel for Micro960

machine	micro960
ident	GENERIC

makeoptions CC="i960-unknown-coff-gcc"
makeoptions CFLAGS="-msa"

makeoptions AS="i960-unknown-coff-as"
makeoptions ASFLAGS="-ASA"

makeoptions LD="i960-unknown-coff-ld"
makeoptions LDFLAGS=""

makeoptions AR="i960-unknown-coff-ar"
makeoptions ARFLAGS="rcs"

makeoptions OBJCOPY="i960-unknown-coff-objcopy"
makeoptions OCFLAGS="-O binary"

makeoptions STRIP="i960-unknown-coff-strip"

makeoptions CPP="i960-unknown-coff-cpp"
makeoptions CPPFLAGS=""

makeoptions KERNEL="kernel.bin"

mainbus0	at root
pit0		at mainbus0 addr 0x200000 stride 2 irq 1 speed 100000 clock 10000000
vdp0		at mainbus0 addr 0x260000 stride 2
ns0		at mainbus0 addr 0x220000 stride 2 irq 2 baud 9600 clock 10000000
wdc0		at mainbus0 addr 0x240000 stride 2
ncr0		at mainbus0 addr 0x280000 stride 2

include "mach/micro960/conf/files.micro960"
include "dev/files.dev"
